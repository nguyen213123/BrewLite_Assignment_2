# Tùy chọn cho Docker Compose: sao chép thành .env và đặt JWT secret dài ít nhất 32 ký tự.
# Khi chạy API trực tiếp qua npm, dùng apps/api/.env.example để tạo apps/api/.env.
JWT_SECRET=

# Required when running seed; supply your own passwords (8 characters to 72 UTF-8 bytes).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
